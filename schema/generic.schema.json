{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenericDrug",
  "type": "object",
  "required": ["id", "name", "drug_class"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "drug_class": { "type": "string" },
