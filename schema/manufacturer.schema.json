{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manufacturer",
  "type": "object",
  "required": ["id", "name", "country"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "country": { "type": "string" },
    "is_psx_listed": { "type": "boolean" },
    "psx_symbol": { "type": ["string", "null"] }
  }
}