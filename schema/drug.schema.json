{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DrugBrand",
  "type": "object",
  "required": ["id", "brand_name", "generic_id", "strength", "dosage_form", "manufacturer_id"],
  "properties": {
    "id": { "type": "string" },
    "brand_name": { "type": "string" },
    "generic_id": { "type": "string" },
    "strength": { "type": "string" },
    "dosage_form": { "type": "string" },
    "price_pkr": { "type": "number" },
    "manufacturer_id": { "type": "string" },
    "prescription_only": { "type": "boolean" }
  }
}